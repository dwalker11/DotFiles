#!/usr/bin/env bash

rofi_command="rofi -theme $HOME/.config/rofi/config/powermenu.rasi"

uptime=$(uptime -p | sed -e 's/up //g')

# Options
if [[ "$DIR" == "powermenus" ]]; then
	shutdown="󰐥"
	reboot="󰜉"
	lock="󰍁"
	suspend="󰒲"
	logout="󰍃 "
	ddir="$HOME/.config/rofi/config"
else
	# Buttons
	layout=`cat $HOME/.config/rofi/config/powermenu.rasi | grep BUTTON | cut -d'=' -f2 | tr -d '[:blank:],*/'`
	if [[ "$layout" == "TRUE" ]]; then
		shutdown="󰐥"
		reboot="󰜉"
		lock="󰍁"
		suspend="󰒲"
		logout="󰍃"
	else
		shutdown="󰐥 Shutdown"
		reboot="󰜉 Restart"
		lock="󰍁 Lock"
		suspend="󰒲 Sleep"
		logout="󰍃 Logout"
	fi
	ddir="$HOME/.config/rofi/config"
fi

# Ask for confirmation
confirm () {
	local answer
	answer=$(printf '%s\n' No Yes | rofi -dmenu -no-custom \
		-p "Are you sure?" -theme "$ddir/confirm.rasi" \
		-me-select-entry "" -me-accept-entry MousePrimary) || return 1
	[[ "$answer" == Yes ]]
}

# Variable passed to rofi
options="$lock\n$suspend\n$logout\n$reboot\n$shutdown"

chosen="$(echo -e "$options" | $rofi_command -p "UP - $uptime" -dmenu -selected-row 0)"
case $chosen in
    $shutdown)
		if confirm; then
			systemctl poweroff
		fi
        ;;
    $reboot)
		if confirm; then
			systemctl reboot
		fi
        ;;
    $lock)
        sh $HOME/.local/bin/lock
        ;;
    $suspend)
		if confirm; then
			mpc -q pause
			amixer set Master mute
			sh $HOME/.local/bin/lock
			systemctl suspend
		fi
        ;;
    $logout)
		if confirm; then
			bspc quit
		fi
        ;;
esac

